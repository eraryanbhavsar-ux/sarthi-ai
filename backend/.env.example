# ===================================================
# SARTHI Backend Environment Variables (.env.example)
# ===================================================

PORT=5001
NODE_ENV=production

# MongoDB Atlas Connection URI (optional - leave empty for automatic in-memory fallback)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sarthi?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=sarthi_super_secure_jwt_secret_hackathon_2026_key
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Allowed Frontend Origin (set to * or your Vercel frontend URL)
CLIENT_URL=*
